<?xml version="1.0" encoding="utf-8"?>
<!-- Premium dark gradient card with hairline border -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="#F01B1E26"
        android:endColor="#F0242836"
        android:startColor="#F015171C"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
    <corners android:radius="28dp" />
</shape>